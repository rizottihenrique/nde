# NDE secrets for docker-compose. Copy to .env and fill in.
# Do NOT commit .env — losing NDE_CREDENTIAL_KEY makes the encrypted data
# (device credentials) UNRECOVERABLE. Keep a safe backup.

# AES-256 key (32 bytes, base64) that encrypts credentials at rest.
# Generate with:  docker compose run --rm serve gen-key
NDE_CREDENTIAL_KEY=

# JWT session signing secret (>= 32 random bytes).
# Generate with:  openssl rand -base64 48 | tr -d '\n'
NDE_JWT_SECRET=

# PostgreSQL password (used by the db service and the app DSN).
# Generate with:  openssl rand -hex 24
POSTGRES_PASSWORD=
